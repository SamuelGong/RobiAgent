environment:
    type: basic
agent:
    type: basic
    max_num_tasks_launched: 8
    max_workers: 4
    task_retry_time_limit: 0
physical:
    camera:
        left:
            fx: 500
            fy: 500
            cx: 320
            cy: 240
            id: 0
            width: 640
            height: 480
            fps: 60
        right:
            fx: 400.255
            fy: 400.255
            cx: 310.688
            cy: 236.320
            width: 640
            height: 480
            fps: 30
            serial_number_or_name: "260322272909"
    arm:
        left:
            id: "my_awesome_follower_arm"
            port: "/dev/tty.usbmodem5B141134931"
            urdf_path: "thirdparty/lerobot/so101/description/so101_new_calib.urdf"
        right:
            id: "so101_track_phone"
            port: "/dev/tty.usbmodem5A7A0575391"
            urdf_path: "thirdparty/lerobot/so101/description/so101_new_calib.urdf"
task:
    face_track:
        geometry:
            face_width_m: 0.18
            pan_axis_cam:
                - 0.055
                - 0.30
                - -0.13
            pan_to_lift_home:
                - 0.00
                - -0.075
                - 0.03
            lift_to_phone_home:
                - 0.00
                - 0.00
                - 0.12
            screen_normal_home:
                - 0.00
                - 0.00
                - 0.12
        model_path: "thirdparty/face_detector.task"
        control_hz: 50
        alpha_xyz: 0.18
        lost_timeout: 2.0
        min_detection_confidence: 0.6
        track_duration_s: 25
        hold_last_on_timeout: true
    face_track_new:
        geometry:
            face_width_m: 0.18
            camera_origin_in_ik_m:
                - 0.0
                - 0.17
                - 0.36
        model_path: "thirdparty/face_detector.task"
        control_hz: 50
        alpha_xyz: 1.0
        lost_timeout: 2.0
        min_detection_confidence: 0.6
        track_duration_s: 25
        hold_last_on_timeout: true
        desired_eye_distance_m: 0.35
        target_plane_below_eye_m: 0.15
        screen_tilt_deg: 30.0
        ik_mode: "hard_bisection"
        ik_bisection_max_depth: 5
        ik_pos_tol_m: 0.01
        ik_rot_tol_rad: 0.10
        face_hold_enabled: true
        face_hold_release_m: 0.025
        face_hold_candidate_m: 0.015
        face_hold_stable_s: 0.10
        target_slew_enabled: true
        target_pos_deadband_m: 0.004
        target_normal_deadband_deg: 0.5
        target_max_pos_step_m: 0.001
        target_max_normal_step_deg: 1.0
    vocal_intro:
        text: "你好，很高兴向你介绍这款新产品！"
        chunk_size: 8
        chunk_delay: 0.1
    phone_touch:
        geometry:
            camera_origin_in_ik_m:
                - -0.07
                - -0.01
                - 0.29
        model_path: "thirdparty/yolo/yolo26x.pt"
        move_epoch: 10
        interpolation_steps: 50
        scroll_epoch: 30
        use_weighted_interpolation: true