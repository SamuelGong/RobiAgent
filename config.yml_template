environment:
    type: basic
agent:
    type: basic
    max_num_tasks_launched: 8
    max_workers: 8
    task_waiting_time_in_sec: 0.1
    task_retry_time_limit: 0
physical:
    camera:
        left:
            fx: 500
            fy: 500
            cx: 320
            cy: 240
            id: 0
            width: 640
            height: 480
            fps: 60
        right:
            fx: 400.255
            fy: 400.255
            cx: 310.688
            cy: 236.320
            width: 640
            height: 480
            fps: 30
            serial_number_or_name: "260322272909"
            warmup_s: 3
    arm:
        left:
            id: "shanghai_tracking_arm"
            port: "/dev/tty.usbmodem5B141139931"
            urdf_path: "thirdparty/lerobot/so101/description/so101_new_calib.urdf"
        right:
            id: "shanghai_touching_arm"
            port: "/dev/tty.usbmodem5A7A0575391"
            urdf_path: "thirdparty/lerobot/so101/description/so101_new_calib.urdf"
task:
    vocal_intro:
        chunk_size: 8
        chunk_delay: 0.1
    track_face_new:
        geometry:
            face_width_m: 0.20
            camera_origin_in_ik_m:
                - 0.06
                - 0.15
                - 0.33
        model_path: "thirdparty/face_detector.task"
        control_hz: 50
        alpha_xyz: 1.0
        lost_timeout: 2.0
        min_detection_confidence: 0.6
        track_duration_s: 22
        hold_last_on_timeout: true
        desired_eye_distance_m: 0.65
        target_plane_below_eye_m: 0.10
        screen_tilt_deg: 10.0
        ik_mode: "hard_bisection"
        ik_bisection_max_depth: 5
        ik_pos_tol_m: 0.02
        ik_rot_tol_rad: 0.02
        face_hold_enabled: true
        face_hold_release_m: 0.025
        face_hold_candidate_m: 0.020
        face_hold_stable_s: 0.01
        target_slew_enabled: true
        target_pos_deadband_m: 0.001
        target_normal_deadband_deg: 0.1
        target_max_pos_step_m: 0.005
        target_max_normal_step_deg: 0.5
    touch_phone:
        geometry:
            camera_origin_in_ik_m:
                - -0.062
                - -0.03
                - 0.26
        model_path: "thirdparty/yolo/yolo26x.pt"
        move_epoch: 10
        interpolation_steps: 50
        scroll_epoch: 30
        use_weighted_interpolation: true
        touch_step: 1
    simple_movement:
        target_pose:
            - 32.395604
            - -106.065934
            - 76.395604
            - 16.263736
            - 1.362637
            - 45.167785
        move_steps: 50
        step_sleep_s: 0.02
        hold_s: 3