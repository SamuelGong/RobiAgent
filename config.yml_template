environment:
    type: basic
agent:
    type: basic
    max_num_tasks_launched: 20
    max_workers: 8
    task_waiting_time_in_sec: 0.1
    task_retry_time_limit: 0
physical:
    camera:
        left:
            fx: 500
            fy: 500
            cx: 320
            cy: 240
            uid: 0x2400000bda5883
            width: 640
            height: 480
            fps: 60
        right:
            fx: 400.255
            fy: 400.255
            cx: 310.688
            cy: 236.320
            width: 640
            height: 480
            fps: 30
            serial_number_or_name: "260322272909"
            warmup_s: 3
    arm:
        left:
            id: "shanghai_tracking_arm"
            port: "/dev/tty.usbmodem5B141139931"
            urdf_path: "thirdparty/lerobot/so101/description/so101_new_calib.urdf"
        right:
            id: "shanghai_touching_arm"
            port: "/dev/tty.usbmodem5A7A0575391"
            urdf_path: "thirdparty/lerobot/so101/description/so101_new_calib.urdf"
task:
    vocal_intro:
        chunk_size: 8
        chunk_delay: 0.1
    track_face_new:
        geometry:
            face_width_m: 0.20
            camera_origin_in_ik_m:
                - 0.06
                - 0.15
                - 0.31
        model_path: "thirdparty/face_detector.task"
        control_hz: 50
        lost_timeout: 2.0
        min_detection_confidence: 0.6
        track_duration_s: 25
        hold_last_on_timeout: true
        desired_eye_distance_m: 0.65
        target_plane_below_eye_m: 0.15
        screen_tilt_deg: 30.0
        ik_mode: "hard_binary_search"
        ik_bisection_max_depth: 6
        ik_binary_search_alpha_step: 0.01
        ik_pos_tol_m: 0.1
        ik_rot_tol_rad: 0.05
        face_hold_enabled: true
        face_hold_release_m: 0.025
        face_hold_candidate_m: 0.020
        face_hold_stable_s: 0.05
        target_slew_enabled: true
        target_pos_deadband_m: 0.001
        target_normal_deadband_deg: 0.1
        target_max_pos_step_m: 0.003
        target_max_normal_step_deg: 0.3
#        ik_debug_enabled: true
#        ik_debug_print: false
#        ik_debug_jsonl_path: ik_debug_log.jsonl
        ik_joint_delta_gate_enabled: true
        ik_max_joint_delta_deg: 8.0
        ik_joint_delta_gate_keys:
            - shoulder_pan.pos
            - shoulder_lift.pos
            - elbow_flex.pos
            - wrist_flex.pos
            - wrist_roll.pos
    touch_phone:
        geometry:
            camera_origin_in_ik_m:
                - -0.074
                - -0.03
                - 0.27
        model_path: "thirdparty/yolo/yolo26x.pt"
        move_epoch: 10
        interpolation_steps: 50
        scroll_epoch: 30
        use_weighted_interpolation: true
        touch_step: 1
    simple_movement:
        move_steps: 50
        step_sleep_s: 0.02
        hold_s: 3